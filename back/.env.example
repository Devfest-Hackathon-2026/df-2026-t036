# .local.envへコピーして設定する。直接起動では自動読込、Composeではenv_fileで渡す。
# APIの接続先プロジェクトIDを明示する。FlutterのJSONは参照しない。
GOOGLE_CLOUD_PROJECT=YOUR_PROJECT_ID
CORS_ORIGINS=http://localhost:3000
# ローカル開発でFlutterの可変ポートを使う場合だけtrueにする。
CORS_ALLOW_LOCALHOST=false
MAINTENANCE_MODE=false
RETRY_AFTER_SECONDS=30
# 定期実行を使う場合は両方を設定する。未設定では内部APIの実行を拒否する。
CLEANUP_SERVICE_ACCOUNT=
CLEANUP_AUDIENCE=

# 承認した作品の保存先。非公開バケットを指定する。
ARTWORK_BUCKET=YOUR_PRIVATE_ARTWORK_BUCKET
